<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Anime Mining — Demon Slayer Edition</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<style>
:root{
  --bg-main:#1a0f0f;
  --bg-card:rgba(28,15,15,.88);
  --bg-card-2:rgba(40,18,18,.95);
  --accent-red:#c41e3a;
  --accent-gold:#ffb703;
  --accent-purple:#7b2cbf;
  --accent-green:#10b981;
  --text:#f8f8f8;
  --dim:#a8a8a8;
  --radius-xl:22px;
  --radius-lg:16px;
  --radius-md:12px;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{
  font-family:system-ui,-apple-system,sans-serif;
  color:var(--text);
  min-height:100vh;
  background:linear-gradient(180deg,rgba(26,15,15,.82) 0%,rgba(10,5,18,.9) 100%),
    url("https://i.postimg.cc/0Q6j4B6x/1788760988257.jpg") center/cover no-repeat fixed;
  overflow-x:hidden;
}
body::before{
  content:"";position:fixed;inset:0;
  background:radial-gradient(circle at 20% 15%,rgba(196,30,58,.18),transparent 45%),
              radial-gradient(circle at 80% 85%,rgba(123,44,191,.12),transparent 50%);
  pointer-events:none;z-index:0;
}
.app{position:relative;z-index:1;width:100%;max-width:430px;margin:0 auto;padding:10px 14px 20px;display:flex;flex-direction:column;min-height:100vh}

/* ===== BOTONES FLOTANTES (Menú + Ajustes) - DERECHA ===== */
.header-actions{
  display:flex;justify-content:center;align-items:center;
  margin-bottom:10px;gap:10px;
}
.right-actions{
  position:fixed;
  right:12px;
  top:50%;
  transform:translateY(-40%);
  display:flex;
  flex-direction:column;
  gap:12px;
  z-index:50;
}
.menu-btn,.settings-btn{
  width:44px;height:44px;border-radius:14px;border:none;
  background:var(--bg-card-2);color:#fff;font-size:20px;
  display:flex;align-items:center;justify-content:center;
  backdrop-filter:blur(10px);cursor:pointer;
  box-shadow:0 4px 16px rgba(0,0,0,.45);
  flex-shrink:0;
  border:1px solid rgba(255,255,255,.08);
}

/* ===== BALANCE REDISEÑADO ===== */
.balance-card{
  background:linear-gradient(145deg,rgba(40,15,15,.9),rgba(25,10,20,.85));
  border-radius:24px;padding:18px 16px 16px;
  text-align:center;margin-bottom:12px;
  border:1px solid rgba(196,30,58,.25);
  box-shadow:0 8px 32px rgba(0,0,0,.4), inset 0 1px 0 rgba(255,255,255,.05);
  position:relative;overflow:hidden;width:100%;
}
.balance-card::before{
  content:"";position:absolute;top:-50%;left:-50%;width:200%;height:200%;
  background:radial-gradient(circle,rgba(255,80,0,.08),transparent 60%);
  animation:glowRotate 12s linear infinite;pointer-events:none;
}
@keyframes glowRotate{to{transform:rotate(360deg)}}
.balance-label{font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--dim);margin-bottom:6px;position:relative}
.balance-amount{
  font-size:32px;font-weight:900;display:flex;align-items:center;justify-content:center;gap:8px;
  position:relative;text-shadow:0 2px 12px rgba(196,30,58,.5);
}
.anim-icon{
  width:32px;height:32px;border-radius:50%;
  background:linear-gradient(135deg,#ff3d00,#c41e3a 40%,#ffb703);
  display:flex;align-items:center;justify-content:center;
  font-size:15px;font-weight:900;color:#fff;
  box-shadow:0 0 0 2px rgba(255,60,0,.3),0 0 14px rgba(255,80,0,.45);
  position:relative;
}
.anim-icon::after{
  content:"";position:absolute;inset:-4px;border-radius:50%;
  border:2px solid transparent;border-top-color:#ffb703;
  animation:spin 3s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg)}}
.balance-rates{display:flex;justify-content:center;gap:10px;margin-top:10px;position:relative;flex-wrap:wrap}
.rate-pill{
  background:rgba(0,0,0,.35);padding:4px 10px;border-radius:20px;
  font-size:11px;color:var(--dim);
}
.rate-pill span{color:var(--accent-gold);font-weight:700}

/* ===== ENERGÍA DELGADA ===== */
.energy-row{
  display:flex;align-items:center;gap:10px;
  background:var(--bg-card);border-radius:14px;
  padding:10px 14px;margin-bottom:16px;
  backdrop-filter:blur(8px);
}
.energy-label{font-size:12px;font-weight:600;white-space:nowrap;min-width:70px}
.energy-track{
  flex:1;height:6px;background:rgba(255,255,255,.08);
  border-radius:10px;overflow:hidden;position:relative;
}
.energy-fill{
  height:100%;border-radius:10px;
  background:linear-gradient(90deg,#10b981,#4ade80,#a3e635);
  box-shadow:0 0 10px rgba(16,185,129,.5);
  transition:width .35s ease;
}
.energy-text{font-size:11px;color:var(--dim);min-width:55px;text-align:right}

/* ===== COLLECT ===== */
.collect-wrap{display:flex;justify-content:center;margin-top:auto;margin-bottom:16px;position:relative}
.collect-btn{
  width:200px;height:200px;border-radius:50%;border:none;
  background:transparent;padding:0;cursor:pointer;
  box-shadow:0 0 0 8px rgba(196,30,58,.18),0 0 50px rgba(255,80,0,.4);
  display:flex;align-items:center;justify-content:center;
  position:relative;overflow:hidden;
  animation:btnPulse 3s infinite ease-in-out;
  transition:transform .2s;
}
.collect-btn:active{transform:scale(.93)}
.collect-btn img{width:100%;height:100%;object-fit:cover;border-radius:50%;pointer-events:none}
.collect-label{
  position:absolute;bottom:16px;left:0;right:0;text-align:center;
  font-size:14px;font-weight:800;color:#fff;
  text-shadow:0 2px 8px #000,0 0 10px rgba(196,30,58,.9);
  background:linear-gradient(transparent,rgba(0,0,0,.55));
  padding:6px 0 10px;border-radius:0 0 50% 50%;pointer-events:none;
}
@keyframes btnPulse{
  0%,100%{box-shadow:0 0 0 8px rgba(196,30,58,.18),0 0 45px rgba(255,80,0,.35)}
  50%{box-shadow:0 0 0 12px rgba(255,80,0,.25),0 0 70px rgba(255,60,0,.5)}
}
.pending-line{text-align:center;font-size:13px;color:var(--dim);margin-bottom:8px}
.pending-line span{color:var(--accent-gold);font-weight:700}

/* ===== NAV ===== */
.nav-bar{
  display:flex;justify-content:space-around;
  background:var(--bg-card);border-radius:20px;
  padding:8px 4px;margin-top:0;
  backdrop-filter:blur(12px);
}
.nav-btn{
  background:none;border:none;color:var(--dim);
  font-size:11px;padding:8px 12px;border-radius:14px;
  display:flex;flex-direction:column;align-items:center;gap:2px;cursor:pointer;
}
.nav-btn .n-icon{font-size:20px}
.nav-btn.active{color:#fff;background:rgba(196,30,58,.28)}

/* ===== TOAST ===== */
.toast{
  position:fixed;top:18px;left:50%;transform:translateX(-50%) translateY(-120px);
  background:var(--bg-card-2);padding:12px 22px;border-radius:14px;
  z-index:9999;transition:transform .35s;font-weight:600;
  max-width:90%;text-align:center;font-size:14px;
  box-shadow:0 8px 30px rgba(0,0,0,.5);
}
.toast.show{transform:translateX(-50%) translateY(0)}

/* ===== MENU LATERAL ===== */
.menu-overlay{
  position:fixed;inset:0;background:rgba(0,0,0,.75);
  z-index:900;opacity:0;visibility:hidden;transition:.3s;
}
.menu-overlay.active{opacity:1;visibility:visible}
.side-menu{
  position:fixed;top:0;left:0;bottom:0;width:300px;max-width:85%;
  background:linear-gradient(180deg,#1f1010,#140a0a);
  z-index:910;transform:translateX(-100%);transition:transform .35s cubic-bezier(.4,0,.2,1);
  display:flex;flex-direction:column;padding:20px 0;overflow-y:auto;
  border-right:1px solid rgba(196,30,58,.25);
}
.side-menu.active{transform:translateX(0)}
.menu-header{padding:0 20px 18px;border-bottom:1px solid rgba(255,255,255,.08);margin-bottom:10px}
.menu-header h3{font-size:18px}
.menu-item{
  display:flex;align-items:center;gap:14px;
  padding:14px 20px;color:var(--text);text-decoration:none;
  font-size:15px;border:none;background:none;width:100%;
  cursor:pointer;transition:background .2s;text-align:left;
}
.menu-item:active,.menu-item:hover{background:rgba(196,30,58,.15)}
.menu-item .m-icon{font-size:20px;width:28px;text-align:center}
.menu-divider{height:1px;background:rgba(255,255,255,.08);margin:8px 20px}

/* ===== MODALES ===== */
.modal{
  position:fixed;inset:0;background:rgba(0,0,0,.88);
  z-index:950;display:none;align-items:flex-end;justify-content:center;
}
.modal.active{display:flex}
.modal-sheet{
  background:linear-gradient(180deg,#251515,#1a0f0f);
  width:100%;max-width:450px;max-height:88vh;
  border-radius:24px 24px 0 0;padding:20px 18px 36px;
  overflow-y:auto;border-top:2px solid rgba(196,30,58,.3);
  animation:slideUp .35s ease-out;
}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}
.modal-head h2{font-size:18px}
.close-modal{background:none;border:none;color:var(--dim);font-size:28px;cursor:pointer;line-height:1}

.stat-row{display:flex;justify-content:space-between;padding:11px 0;border-bottom:1px solid rgba(255,255,255,.07);font-size:14px}
.item-card{background:rgba(0,0,0,.35);border-radius:14px;padding:14px;margin-bottom:12px}
.buy-btn,.task-btn,.convert-btn{
  width:100%;border:none;padding:11px;border-radius:12px;
  background:var(--accent-red);color:#fff;font-weight:600;cursor:pointer;margin-top:8px;
}
.buy-btn:disabled,.task-btn:disabled{background:#333;color:#777}
.price-val{font-weight:700;color:var(--accent-gold);font-size:15px}
.tab-buttons{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:16px}
.tab-btn{padding:10px;border-radius:12px;border:none;background:var(--bg-card);color:var(--text);cursor:pointer}
.tab-btn.active{background:var(--accent-red)}
.tab-content{display:none}
.tab-content.active{display:block}

.char-banner{
  display:flex;align-items:center;gap:14px;
  background:linear-gradient(135deg,rgba(30,10,10,.8),rgba(50,15,15,.65));
  border-radius:16px;padding:14px;margin-bottom:16px;
  border:1px solid rgba(196,30,58,.25);
}
.char-avatar{
  width:78px;height:78px;min-width:78px;border-radius:50%;
  overflow:hidden;box-shadow:0 0 0 3px rgba(196,30,58,.4);
}
.char-avatar img{width:100%;height:100%;object-fit:cover}
.char-info h4{font-size:15px;margin-bottom:3px}
.char-info p{font-size:12px;color:var(--dim);line-height:1.3}

.terms-content{font-size:13px;line-height:1.55;color:#ddd}
.terms-content h3{margin:16px 0 6px;color:var(--accent-gold);font-size:14px}
.terms-content p{margin-bottom:10px}

.lang-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}
.lang-btn{padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,.12);background:var(--bg-card);color:#fff;cursor:pointer}
.lang-btn.active{border-color:var(--accent-red);background:rgba(196,30,58,.25)}

.vip-box{background:rgba(0,0,0,.4);border-radius:14px;padding:14px;margin-top:12px;font-size:13px;line-height:1.5}
.badge-active{background:rgba(16,185,129,.2);color:#10b981;padding:2px 8px;border-radius:6px;font-size:11px;font-weight:700}
.badge-expired{background:rgba(239,68,68,.2);color:#ef4444;padding:2px 8px;border-radius:6px;font-size:11px;font-weight:700}

.ref-input{flex:1;background:rgba(255,255,255,.08);border:none;border-radius:10px;padding:10px;color:#fff}
.copy-btn{background:var(--accent-red);border:none;color:#fff;padding:10px 14px;border-radius:10px;font-weight:600}
.convert-input{width:100%;background:rgba(255,255,255,.08);border:none;border-radius:10px;padding:12px;color:#fff;font-size:15px;margin:8px 0}
</style>
</head>
<body>

<div class="app">
  <div class="toast" id="toast"></div>

  <!-- HEADER: Balance (centrado) -->
  <div class="header-actions">
    <div class="balance-card">
      <div class="balance-label">Balance Total</div>
      <div class="balance-amount">
        <div class="anim-icon">A</div>
        <span id="token-count">0.000</span>
      </div>
      <div class="balance-rates">
        <div class="rate-pill">⚡ <span id="mine-rate">0.001</span>/s</div>
        <div class="rate-pill">🔥 <span id="pending-amount">0</span></div>
      </div>
    </div>
  </div>

  <!-- BOTONES FLOTANTES DERECHA: Menú arriba + Ajustes abajo -->
  <div class="right-actions">
    <button class="menu-btn" onclick="openMenu()" title="Menú">☰</button>
    <button class="settings-btn" onclick="openModal('settings')" title="Ajustes">⚙️</button>
  </div>

  <!-- ENERGÍA DELGADA -->
  <div class="energy-row">
    <div class="energy-label">⚡ Energía</div>
    <div class="energy-track"><div class="energy-fill" id="energy-bar"></div></div>
    <div class="energy-text" id="energy-text">100/100</div>
  </div>
  <button id="recharge-btn" onclick="rechargeEnergy()" style="display:none;width:100%;margin-bottom:12px;padding:11px;border:none;border-radius:12px;background:linear-gradient(90deg,#7b2cbf,#c41e3a);color:#fff;font-weight:700;font-size:13px;cursor:pointer">
    📺 Ver anuncio para recargar energía (2h)
  </button>

  <div class="pending-line">Acumulado: <span id="accumulated-display">0.000 ANIM</span></div>

  <!-- COLLECT -->
  <div class="collect-wrap">
    <button class="collect-btn" id="collect-button">
      <img src="https://i.postimg.cc/RFRQfbgJ/1788820020964.jpg" alt="Recolectar">
      <span class="collect-label">RECOLECTAR</span>
    </button>
  </div>

  <!-- NAV -->
  <div class="nav-bar">
    <button class="nav-btn active" data-tab="mine"><span class="n-icon">⛏️</span>Minar</button>
    <button class="nav-btn" data-tab="upgrades"><span class="n-icon">⚡</span>Respiración</button>
    <button class="nav-btn" data-tab="rewards"><span class="n-icon">🎁</span>Recompensas</button>
  </div>
</div>

<!-- ========== MENÚ LATERAL ========== -->
<div class="menu-overlay" id="menuOverlay" onclick="closeMenu()"></div>
<div class="side-menu" id="sideMenu">
  <div class="menu-header">
    <h3>Menú</h3>
  </div>

  <button class="menu-item" onclick="openModal('profile');closeMenu()">
    <span class="m-icon">👤</span> Perfil de Usuario
  </button>
  <button class="menu-item" onclick="openModal('level');closeMenu()">
    <span class="m-icon">📈</span> Progreso de Nivel
  </button>
  <button class="menu-item" onclick="openModal('wallet');closeMenu()">
    <span class="m-icon">💼</span> Billetera
  </button>
  <button class="menu-item" onclick="openModal('friends');closeMenu()">
    <span class="m-icon">👥</span> Amigos / Referidos
  </button>

  <div class="menu-divider"></div>

  <a class="menu-item" href="https://t.me/ANIME_MINING_OFICIAL" target="_blank">
    <span class="m-icon">📢</span> Página Oficial
  </a>
  <a class="menu-item" href="https://t.me/+c34ziM0gjlJjMWJh" target="_blank">
    <span class="m-icon">💬</span> Grupo de Chat
  </a>
  <a class="menu-item" href="https://t.me/+J52GmerlZPpmZGVh" target="_blank">
    <span class="m-icon">🛠️</span> Soporte
  </a>
  <button class="menu-item" onclick="openModal('terms');closeMenu()">
    <span class="m-icon">📄</span> Términos y Condiciones
  </button>

  <div class="menu-divider"></div>

  <button class="menu-item" onclick="openModal('settings');closeMenu()">
    <span class="m-icon">⚙️</span> Ajustes
  </button>
</div>

