# Backend Anime Mining - Variables de Entorno

# Servidor
PORT=3000
NODE_ENV=production
BACKEND_URL=https://anime-mining-backend.onrender.com

# Firebase
FIREBASE_PROJECT_ID=anime-mining-tlg
FIREBASE_PRIVATE_KEY=your_private_key_here
FIREBASE_CLIENT_EMAIL=your_client_email_here

# Keep-Alive
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL_MINUTES=5

# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=animemining_bot

# Seguridad
JWT_SECRET=your_jwt_secret_here
ALLOWED_ORIGINS=https://t.me